{
  "name": "faceit-extension-loader",
  "version": "0.3.0-beta.22",
  "private": true,
  "description": "Experimental extension loader and mod manager for the FACEIT desktop client.",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dimitrymas/faceit-extension-loader.git"
  },
  "bugs": {
    "url": "https://github.com/Dimitrymas/faceit-extension-loader/issues"
  },
  "homepage": "https://github.com/Dimitrymas/faceit-extension-loader#readme",
  "bin": {
    "faceit-extension-loader": "./bin/faceit-extension-loader.js"
  },
  "scripts": {
    "clean": "node ./scripts/clean.js",
    "build:win-portable": "node ./scripts/build-win-portable.js",
    "build:win-installer": "node ./scripts/build-win-installer.js",
    "patch": "node ./bin/faceit-extension-loader.js patch",
    "inspect": "node ./bin/faceit-extension-loader.js inspect",
    "test": "node --test test/*.js"
  },
  "dependencies": {
    "@electron/asar": "^3.4.1",
    "electron-chrome-extensions": "^4.9.0",
    "yauzl": "^3.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
